# ==============================================================================
# WAR KONSUMSI — SYSTEMD SERVICE FOR FRONTEND WEB
# ==============================================================================
# File: /etc/systemd/system/war-konsumsi-web.service
#
# Commands:
#   sudo systemctl daemon-reload
#   sudo systemctl enable war-konsumsi-web
#   sudo systemctl start war-konsumsi-web
#   sudo systemctl status war-konsumsi-web
# ==============================================================================

[Unit]
Description=War Konsumsi Next.js Web Frontend
After=network.target war-konsumsi-api.service
Wants=war-konsumsi-api.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/war-konsumsi/apps/web
Environment=NODE_ENV=production
EnvironmentFile=/var/www/war-konsumsi/.env
ExecStart=/usr/bin/npx next start -p 3000
Restart=always
RestartSec=5
StandardOutput=append:/var/log/war-konsumsi/web.log
StandardError=append:/var/log/war-konsumsi/web-error.log

[Install]
WantedBy=multi-user.target
