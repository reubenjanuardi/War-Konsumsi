# ==============================================================================
# WAR KONSUMSI — PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# ==============================================================================
# Copy this file to .env on your production VPS:
#   cp .env.production.example .env
#
# CRITICAL SECURITY INVARIANTS:
# 1. Never commit the real .env file with secrets into version control.
# 2. PostgreSQL container runs in private Docker bridge network (war_internal_net).
#    Port 5432 is NEVER exposed publicly or mapped to the host interface.
# 3. Web and API bind strictly to 127.0.0.1 (host loopback) behind Nginx HTTPS.
# 4. Always replace JWT_SECRET, ADMIN_SECRET, and POSTGRES_PASSWORD with secure keys.
# ==============================================================================

# Node Environment
NODE_ENV=production

# Server Ports (Internal to VPS behind Nginx reverse proxy)
PORT=4000
WEB_PORT=3000

# Application URLs
# Replace 103.xxx.xxx.xxx with your actual VPS Public IP (served over HTTPS)
APP_URL=https://103.xxx.xxx.xxx
API_URL=http://127.0.0.1:4000

# Frontend Public URLs (Optional)
# In production behind Nginx, leave these EMPTY so the browser automatically
# uses window.location.origin (e.g. https://103.xxx.xxx.xxx/api and /socket.io).
# Set these ONLY if your API or WebSocket is hosted on a separate external host/subdomain.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=

# PostgreSQL Database Credentials (used by Docker Compose postgres service)
POSTGRES_DB=war_konsumsi
POSTGRES_USER=war_app_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# PostgreSQL Database Connection URL (used by API container inside Docker network)
# Format: postgres://<user>:<password>@postgres:5432/<dbname>
DATABASE_URL=postgres://war_app_user:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/war_konsumsi

# Database Connection Pool
# Recommended: 30 - 50 for 200 - 500 concurrent selection participants
DATABASE_POOL_MAX=40

# Security & Secrets
# Generate a strong 64-character random string for JWT_SECRET:
#   openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_64_HEX_OR_BASE64_STRING

# Admin Master Secret (Used by event organizers to log into /admin)
ADMIN_SECRET=REPLACE_WITH_VERY_STRONG_ADMIN_SECRET_KEY
